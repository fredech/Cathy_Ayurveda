# Clé API Resend — https://resend.com/api-keys
# À définir dans Vercel (Settings → Environment Variables) pour la production.
Resend_key=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# Expéditeur. Le domaine doit être vérifié dans Resend (Domains).
# Resend refuse d'envoyer depuis une adresse @gmail.com.
# Par défaut : Cathy Ayurveda <onboarding@resend.dev>
# (adresse de test Resend : n'envoie qu'à l'e-mail du compte Resend)
CONTACT_FROM_EMAIL=Cathy Ayurveda <onboarding@resend.dev>

# Destinataire des messages du formulaire.
# Par défaut : cathyayurveda@gmail.com
email_contact=cathyayurveda@gmail.com
# Alias accepté : CONTACT_TO_EMAIL
