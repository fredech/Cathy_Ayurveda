{
  "name": "cathy-ayurveda",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Site vitrine de Cathy Ayurveda — coach franco-indienne en Ayurveda.",
  "scripts": {
    "dev": "node scripts/images.mjs --if-missing && vite",
    "images": "node scripts/images.mjs",
    "fonts": "node scripts/fonts.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "node scripts/images.mjs && tsc --noEmit && vite build && node scripts/prerender.mjs",
    "preview": "vite preview --port 4173 --strictPort"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "resend": "^6.37.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
